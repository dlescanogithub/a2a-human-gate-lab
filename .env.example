# Copy to .env locally if you want. Never commit .env.
# Empty means "not set". The demo generates its own NOT REAL tokens and does not read these.

API_TOKEN=
ADMIN_TOKEN=

# Cassette and fake planners need no key. LIVE_MODE is unused by the xAI command.
LLM_PROVIDER=fake
LIVE_MODE=0
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Opt-in live planner. Off unless LIVE_ENABLED=1. Never put a real key in this file.
# CI and pytest leave LIVE_ENABLED unset. The key is read from the environment only.
LIVE_ENABLED=0
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1/chat/completions
XAI_MODEL=grok-4.20-0309-non-reasoning
MAX_LIVE_SPEND_USD=0.10
# Fallback rates [EST] 2026-10-18, used only when the response has no cost ticks.
# XAI_INPUT_USD_PER_MTOK=3.0
# XAI_CACHED_USD_PER_MTOK=0.75
# XAI_OUTPUT_USD_PER_MTOK=15.0
# XAI_PRICE_AS_OF=2026-10-18

# Placeholder only. Not a deployed host.
PUBLIC_BASE_URL=http://127.0.0.1:8765
A2A_HOST=127.0.0.1
A2A_PORT=8765

LOG_LEVEL=INFO
EVIDENCE_PATH=var/evidence.jsonl
SEED=42
MAX_DOWNSTREAM_ATTEMPTS=3
