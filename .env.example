# Copy to .env locally if you want. Never commit .env.
# Empty means "not set". The demo generates its own NOT REAL tokens and does not read these.

API_TOKEN=
ADMIN_TOKEN=

# fake (default) or cassette inside the eval harness. openai is off unless LIVE_MODE=1.
LLM_PROVIDER=fake
LIVE_MODE=0
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Placeholder only. Not a deployed host.
PUBLIC_BASE_URL=http://127.0.0.1:8765
A2A_HOST=127.0.0.1
A2A_PORT=8765

LOG_LEVEL=INFO
EVIDENCE_PATH=var/evidence.jsonl
SEED=42
MAX_DOWNSTREAM_ATTEMPTS=3
